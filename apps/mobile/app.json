{
  "expo": {
    "name": "Sanjari",
    "slug": "sanjari",
    "icon": "./assets/icon.png",
    "scheme": "sanjari",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sanjari.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Sanjari uses the camera for profile photos and optional selfie verification.",
        "NSLocationWhenInUseUsageDescription": "Sanjari uses approximate location to recommend nearby compatible adults.",
        "NSMicrophoneUsageDescription": "Sanjari uses the microphone for optional voice introductions."
      }
    },
    "android": {
      "package": "com.sanjari.app",
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "RECORD_AUDIO", "POST_NOTIFICATIONS"]
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization", "expo-notifications", "./plugins/withCleartextTraffic"],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "apiUrl": "http://37.60.238.125:3400/api/v1"
    }
  }
}
